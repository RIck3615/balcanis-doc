# Projet Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé secrète « service_role » : sert uniquement à créer des agents et réinitialiser
# leurs mots de passe depuis la page Agents. Ne jamais la partager, ne jamais
# l'envoyer par messagerie, ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
